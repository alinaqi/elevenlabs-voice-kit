{
  "name": "@workhub/voice-kit",
  "version": "0.1.0",
  "description": "Make ElevenLabs voice (TTS, STT, voice agents, Speech Engine) trivial for any use case.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./presets": {
      "types": "./dist/presets/index.d.ts",
      "default": "./dist/presets/index.js"
    },
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "default": "./dist/tools/index.js"
    },
    "./next": {
      "types": "./dist/next/index.d.ts",
      "default": "./dist/next/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@elevenlabs/react": ">=1",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "@elevenlabs/react": {
      "optional": true
    }
  },
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "^2.79.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@elevenlabs/react": "^1.24.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "dotenv": "^18.0.10",
    "react": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alinaqi/elevenlabs-voice-kit",
    "directory": "packages/voice-kit"
  },
  "license": "MIT"
}
